dim_date = 
ADDCOLUMNS(
    CALENDAR(
        MIN(dim_customers[SignupDate]), 
        MAX(fact_orders[PaymentDate])
    ),
    "Year", YEAR([Date]),
    "Month", FORMAT([Date], "MMMM"),
